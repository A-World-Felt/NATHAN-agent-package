          <mxGeometry x="440" y="495" width="290" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hidden" value="TOUT CE QUI EST ICI EST INVISIBLE POUR LUI&#xa;&#xa;quelle app tourne  ·  si les fichiers existent vraiment  ·  s&#39;il y a un réseau&#xa;si l&#39;outil écrit sur disque ou modifie une variable en mémoire&#xa;s&#39;il est en production ou dans une suite de tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;dashed=1;fontSize=15;verticalAlign=middle;" vertex="1" parent="1">
