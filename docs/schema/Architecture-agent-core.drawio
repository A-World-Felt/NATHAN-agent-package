        </mxCell>
        <mxCell id="out" value="CE QU&#39;IL PRODUIT&#xa;&#xa;• du texte&#xa;   OU&#xa;• des appels d&#39;outils :&#xa;   { name: &quot;navigate&quot;, args: { page: &quot;réglages&quot; } }&#xa;&#xa;→ pas d&#39;appel d&#39;outil = il a fini" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;fontSize=14;" vertex="1" parent="1">
