        <mxCell id="agent" value="L&#39;AGENT (le modèle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontStyle=1;verticalAlign=top;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="agentn" value="ne sait ni où il tourne, ni ce qu&#39;il y a derrière" style="text;html=1;align=center;fontSize=13;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="400" y="168" width="360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="in" value="CE QU&#39;IL REÇOIT&#xa;&#xa;• le prompt système&#xa;• l&#39;historique des messages&#xa;• la LISTE DES OUTILS :&#xa;   nom + description + schéma des paramètres&#xa;&#xa;→ rien de plus" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;fontSize=14;" vertex="1" parent="1">
