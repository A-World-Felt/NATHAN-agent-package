        </mxCell>
        <mxCell id="key1" value="CONSÉQUENCE — ce n&#39;est pas une astuce, c&#39;est une propriété structurelle :&#xa;qui contrôle la frontière des outils contrôle la réalité entière de l&#39;agent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=16;verticalAlign=middle;fontSize=16;fontStyle=1" vertex="1" parent="1">
