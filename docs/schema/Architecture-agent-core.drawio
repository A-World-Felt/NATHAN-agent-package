        <mxCell id="done" value="→ AgentResult { content, toolCalls, stopReason: &quot;completed&quot;, iterations }" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="160" y="635" width="800" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="L&#39;ABSENCE D&#39;APPEL D&#39;OUTIL EST LE SIGNAL D&#39;ARRÊT — chemin nominal.&#xa;Pas de champ status déclaré par le modèle : ce serait isDone sous un autre nom. Un agent parti en vrille&#xa;rapporterait &quot;reasoning&quot; indéfiniment — le symptôme serait produit par le processus défaillant lui-même." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=16;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="100" y="700" width="960" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fx" value="SORTIE FORCÉE — on fait atterrir, on ne coupe pas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;fontStyle=1;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="810" width="960" height="270" as="geometry" />
        </mxCell>
        <mxCell id="fx1" value="DÉCLENCHEURS&#xa;&#xa;budget : itérations, durée&#xa;ou jetons — la PREMIÈRE&#xa;borne atteinte gagne&#xa;&#xa;stuck : même outil, mêmes&#xa;arguments, ≥ 3 fois de suite&#xa;(observable de l&#39;extérieur,&#xa;sans rien demander au modèle)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="125" y="855" width="270" height="200" as="geometry" />
        </mxCell>
        <mxCell id="fx2" value="1. injecter&#xa;&#xa;&quot;budget atteint,&#xa;conclus avec ce&#xa;que tu as&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=12;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="885" width="180" height="140" as="geometry" />
        </mxCell>
        <mxCell id="fx3" value="2. complete(messages)&#xa;SANS OUTILS&#xa;&#xa;c&#39;est CE point qui garantit&#xa;l&#39;atterrissage : le modèle&#xa;ne PEUT plus rien appeler,&#xa;donc il rédige" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;verticalAlign=middle;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="645" y="885" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="fx4" value="3. AgentResult&#xa;&#xa;stopReason:&#xa;&quot;budget&quot;&#xa;ou &quot;stuck&quot;&#xa;&#xa;→ une réponse rédigée,&#xa;jamais un résultat tronqué" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="880" y="885" width="155" height="140" as="geometry" />
        </mxCell>
        <mxCell id="fe1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fx1" target="fx2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fx2" target="fx3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fx3" target="fx4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n3b" value="maxIterations subsiste comme DERNIER FILET contre un bug de boucle — plus comme mécanisme principal.&#xa;Bénéfice pour les évals : « ce modèle conclut-il de lui-même, ou tape-t-il toujours le budget ? » devient une métrique.&#xa;Un modèle à 100 % de réussite mais toujours en &quot;budget&quot; n&#39;est pas le même produit qu&#39;un modèle qui termine seul." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=16;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="100" y="1105" width="960" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4 — Le harnais" id="p4">
