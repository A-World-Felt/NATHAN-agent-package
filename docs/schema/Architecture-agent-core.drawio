          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t1b" value="Son univers entier tient dans des messages. Il n&#39;a aucun autre accès au monde." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="800" height="30" as="geometry" />
