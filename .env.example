# Copier en `.env` (jamais commite). L'APPLICATION charge ce fichier ;
# la librairie, elle, lit seulement process.env (CLAUDE.md, packaging).

# Fournisseur LLM actif — doit correspondre a une cle de l'union PROVIDERS.
LLM_PROVIDER=ollama

# Ollama : local, gratuit, aucune cle. Valeurs par defaut d'une installation standard.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
